// GiftyGram Flowers — operations schema.
// Status/role/source/photo-type are plain strings (not Prisma enums) so this
// schema ports cleanly to Postgres later without an enum migration step.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  role      String // "OPERATIONS" | "FLORIST" | "DRIVER"
  phone     String? // shown to the customer on the tracking page once a driver is out for delivery
  pinHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  floristOrders Order[]       @relation("FloristOrders")
  driverOrders  Order[]       @relation("DriverOrders")
  statusEvents  StatusEvent[]
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  // Customer-facing tracking identifier. Deliberately separate from
  // orderNumber (sequential, printed on receipts, easy to guess) and from id
  // (already trusted as a capability token elsewhere, e.g. /deliver/[id] —
  // reusing it here would blur two different trust boundaries). Every code
  // path that creates an Order sets it (see lib/trackingToken.ts).
  trackingToken   String    @unique
  // Shopify's own order token (the one in order_status_url). The tracking
  // page accepts it as well as trackingToken, because Shopify renders the
  // order-confirmation email at checkout — before this row exists — so that
  // email can only link with a token Shopify itself already holds. Just as
  // unguessable, and it's what already guards Shopify's own status page.
  shopifyOrderToken String? @unique
  source          String // "SHOPIFY" | "WHATSAPP"
  // Set the moment Operations hand-corrects any order detail (address, name,
  // delivery date, etc.) via updateOrderAction/rescheduleOrderAction. Once
  // true, the Shopify webhook handler stops re-syncing descriptive fields
  // for this order — otherwise a routine webhook redelivery (Shopify
  // retries for days after an order is placed, unrelated to any real
  // change) silently overwrites the correction with the original,
  // now-outdated Shopify data.
  editedByOps     Boolean   @default(false)
  shopifyOrderId  String?   @unique
  status          String    @default("NEW")
  // "NEW" | "ASSIGNED_FLORIST" | "READY" | "ASSIGNED_DRIVER" | "OUT_FOR_DELIVERY" | "DELIVERED" | "FAILED_DELIVERY" | "CANCELLED"

  senderName       String?
  senderPhone      String?
  // The buyer's email — Shopify's order.email, not the recipient's. Used to
  // send status-update emails (order ready, delivered) via Klaviyo; never
  // shown in the ops UI, since staff work off phone numbers.
  email            String?
  recipientName    String
  recipientPhone   String
  deliveryAddress  String
  deliveryArea     String?
  deliveryMethod   String? // "PICKUP" | "DELIVERY" — from Shopify's checkout note attribute
  mapsLink         String?
  cardMessage      String?
  occasion         String?
  deadlineAt       DateTime? @db.Timestamptz(3)
  // Shopify's raw delivery-time-window text (e.g. "6:00 PM - 9:00 PM"), kept
  // as-is for display — deadlineAt only stores the window's end, computed
  // for sorting/overdue purposes, which loses the actual customer-picked
  // window otherwise.
  deliveryTimeSlot String?

  bouquetName        String?
  referenceImageUrl  String?

  // Set when a driver or outside courier marks a delivery attempt failed —
  // cleared automatically once Operations moves the order to a new status.
  deliveryFailureReason String?

  approvalStatus     String    @default("PENDING") // "PENDING" | "APPROVED" | "CHANGES_REQUESTED"
  approvalDeadline   DateTime? @db.Timestamptz(3)
  changeRequestNote  String?

  floristId String?
  florist   Employee? @relation("FloristOrders", fields: [floristId], references: [id])

  // A delivery is either a team driver (driverId, PIN login) or an outside
  // courier (externalDriverName, no account — just a shareable link). Never
  // both: assigning one clears the other.
  driverId           String?
  driver             Employee? @relation("DriverOrders", fields: [driverId], references: [id])
  externalDriverName  String?
  externalDriverPhone String?

  notes String?

  // Slider is the outsourced courier network. Its drivers mark pickup,
  // delivery and photo proof inside Slider's own app — that's how they get
  // paid — and ignore our /deliver link, so we read their record instead of
  // asking them to do the work twice. Orders are still placed by hand in
  // Slider's dashboard, which means Slider's own "order_id" (our reference)
  // comes back null; Operations pastes the Slider order number here once and
  // that number is the entire link between the two systems.
  sliderOrderNumber String?   @unique
  sliderStatus      String? // Slider's raw status, kept for display/debugging
  sliderTrackingUrl String?
  sliderSyncedAt    DateTime? @db.Timestamptz(3)
  // Last sync failure, shown to Operations so a mistyped number or a dead
  // key surfaces on the order itself instead of only in the logs.
  sliderSyncError   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  statusEvents StatusEvent[]
  photos       Photo[]

  @@index([status])
  @@index([floristId])
  @@index([driverId])
}

// Backs login rate-limiting — see loginAction. Rows are cheap and small;
// not worth a cleanup job at this volume.
model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  employeeId String
  success    Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([ip, employeeId, createdAt])
  @@index([ip, createdAt])
}

model StatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

model Photo {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // "BOUQUET" | "DELIVERY"
  url       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}
